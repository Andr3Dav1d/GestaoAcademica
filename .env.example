# Banco de Dados (deve bater com POSTGRES_USER/PASSWORD/DB do docker-compose)
DATABASE_URL="postgresql://SEU_USUARIO:SUA_SENHA@postgres:5432/gestao_academica"

# Autenticação (Conta 1 / Padrão)
AUTH_USERNAME_1="admin"
AUTH_PASSWORD_1="sua-senha-1"
# AUTH_PASSWORD_HASH_1="$2a$10$SEU_HASH_AQUI"

# Autenticação (Conta 2 - Opcional)
AUTH_USERNAME_2="user2"
AUTH_PASSWORD_2="sua-senha-2"
# AUTH_PASSWORD_HASH_2="$2a$10$SEU_HASH_AQUI"

# Compatibilidade retroativa (opcional, se não usar as de cima)
AUTH_USERNAME="admin"
AUTH_PASSWORD="sua-senha-aqui"

JWT_SECRET="troque-por-uma-string-longa-e-aleatoria-em-producao"

# API Externa de Salas
GESTAO_SALAS_TENANT="alcindo"

# Webhook Discord (opcional)
DISCORD_WEBHOOK_URL="https://discord.com/api/webhooks/SEU_ID/SEU_TOKEN"

# URL pública da aplicação
APP_URL="http://localhost:3000"
