# Configurações de Conexão ao Banco de Dados (PostgreSQL via Drizzle ORM)
# Modo Local (Docker Compose com Postgres embutido):
DATABASE_URL="postgresql://gestao_user:gestao_pass@localhost:5432/gestao_academica"
# Modo VPS (Postgres já existente na VPS — só trocar essa variável):
# DATABASE_URL="postgresql://usuario_vps:senha_vps@postgres-vps-host:5432/gestao_academica"

# Autenticação
AUTH_USERNAME="admin"
# Hash bcrypt da senha de acesso (opcional se AUTH_PASSWORD for usado em dev)
AUTH_PASSWORD_HASH="$2a$10$7v.9T3rY5sU/2eQ8mK.1v.wR3pX5zY7aB9cD1eF3gH5iJ7kL9mN1o"
AUTH_PASSWORD="admin123"
JWT_SECRET="gestao-academica-secret-key-super-segura-troque-em-prod"

# API Externa de Agendamentos de Salas
GESTAO_SALAS_TENANT="alcindo"

# Alerta Discord (Webhook)
DISCORD_WEBHOOK_URL="https://discord.com/api/webhooks/seu_webhook_id/seu_token"

# URL da Aplicação (usada nos links enviados pelo Webhook)
APP_URL="http://localhost:3000"

# Intervalo do Cron de notificações (padrão: a cada 15 minutos)
CRON_SCHEDULE="*/15 * * * *"
